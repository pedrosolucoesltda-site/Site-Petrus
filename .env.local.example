# ─────────────────────────────────────────────────────────────
# Supabase — https://app.supabase.com → Project Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-only, NEVER exposed to the browser.
# Used by scripts / admin actions (e.g. creating users). Optional for basic run.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Anthropic — https://console.anthropic.com → API Keys
# Powers the 5 AI assistants in the right rail.
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional override. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5
